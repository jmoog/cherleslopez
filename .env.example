# ──────────────────────────────────────────────────────────────────
# Variables d'environnement — charles-lopez.fr
# À configurer dans Coolify au déploiement (ne JAMAIS committer le vrai .env)
# ──────────────────────────────────────────────────────────────────

# Brevo (envoi des emails du formulaire de devis) — https://app.brevo.com
BREVO_API_KEY=xkeysib-...

# Destinataires des notifications de demande de devis (séparés par des virgules)
ADMIN_EMAILS=charles.lopez@hotmail.fr,jmoog27@gmail.com

# Expéditeur (adresse vérifiée + domaine authentifié DKIM/DMARC dans Brevo)
FROM_EMAIL=contact@charles-lopez.fr
FROM_NAME=Charles Lopez - Artisan couvreur (31)

# Cloudflare Turnstile (anti-robot du formulaire) — https://dash.cloudflare.com
TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# Règles anti-spam centralisées — partagées avec les autres sites
# (fallback intégré au code si le repo est injoignable)
SPAM_RULES_URL=https://raw.githubusercontent.com/jmoog/antispam-rules/main/rules.json
SPAM_RULES_TTL=3600
