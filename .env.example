# ──────────────────────────────────────────────────────────────────
# Variables d'environnement — modèle site artisan
# À configurer sur le serveur au déploiement (ne JAMAIS committer le vrai .env)
# ──────────────────────────────────────────────────────────────────

# Brevo (envoi des emails du formulaire de devis) — https://app.brevo.com
BREVO_API_KEY=xkeysib-...

# Destinataires des notifications de demande de devis (séparés par des virgules)
ADMIN_EMAILS=contact@exemple.fr

# Expéditeur (adresse vérifiée + domaine authentifié DKIM/DMARC dans Brevo)
FROM_EMAIL=contact@exemple.fr
FROM_NAME=Nom Entreprise

# Cloudflare Turnstile (anti-robot du formulaire) — https://dash.cloudflare.com
TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# Règles anti-spam centralisées (optionnel — fallback intégré au code
# si le repo est injoignable)
SPAM_RULES_URL=https://raw.githubusercontent.com/exemple/antispam-rules/main/rules.json
SPAM_RULES_TTL=3600
