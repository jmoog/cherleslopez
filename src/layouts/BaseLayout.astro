---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingContact from '../components/FloatingContact.astro';
import BandeauCookies from '../components/BandeauCookies.astro';
import { SITE } from '../data/site.ts';
import { AREA_SERVED } from '../data/schemas.ts';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  extraSchemas?: object[];
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/og-placeholder.png',
  extraSchemas = [],
} = Astro.props;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Police auto-hébergée : @font-face + WOFF2 servis depuis le domaine. RGPD-OK. -->
    <Font cssVariable="--font-base" preload />

    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- TODO Search Console : décommenter et renseigner le code de vérification.
    <meta name="google-site-verification" content="XXXXXXXXXX" /> -->
    <link rel="canonical" href={canonicalURL} />

    <meta name="geo.region" content={`FR-${SITE.departementNum}`} />
    <meta name="geo.placename" content={`${SITE.ville}, ${SITE.departement}`} />
    <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
    <meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.nom} — ${SITE.slogan}`} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={`${SITE.nom} — ${SITE.slogan}`} />

    <!-- Twitter / X — grand aperçu -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- Données structurées LocalBusiness.
         TODO : préciser le @type selon le métier (RoofingContractor, Plumber,
         Electrician, HousePainter, GeneralContractor… — voir schema.org). -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "RoofingContractor",
      "@id": `${SITE.url}/#localbusiness`,
      "name": SITE.nom,
      "alternateName": [SITE.nom],
      "description": description,
      "image": `${SITE.url}/images/logo-placeholder.png`,
      "logo": { "@type": "ImageObject", "url": `${SITE.url}/images/logo-placeholder.png`, "caption": `Logo ${SITE.nom}` },
      "url": SITE.url,
      "telephone": SITE.telE164,
      "contactPoint": [
        { "@type": "ContactPoint", "telephone": SITE.telE164, "contactType": "customer service", "areaServed": "FR", "availableLanguage": "French" },
        { "@type": "ContactPoint", "telephone": SITE.telUrgenceE164, "contactType": "emergency", "areaServed": "FR", "availableLanguage": "French" }
      ],
      "email": SITE.email,
      "founder": { "@type": "Person", "name": SITE.dirigeant },
      "priceRange": "€€",
      "currenciesAccepted": "EUR",
      "address": { "@type": "PostalAddress", "streetAddress": SITE.rue, "postalCode": SITE.cp, "addressLocality": SITE.ville, "addressRegion": SITE.region, "addressCountry": "FR" },
      "geo": { "@type": "GeoCoordinates", "latitude": SITE.geo.lat, "longitude": SITE.geo.lng },
      "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"], "opens": "08:00", "closes": "20:00" }
      ],
      "areaServed": AREA_SERVED,
      "knowsAbout": ["Rénovation de toiture", "Réparation de toiture", "Nettoyage et démoussage de toiture", "Pose et remplacement de gouttières", "Étanchéité de toiture", "Recherche de fuite", "Traitement de toiture", "Zinguerie", "Pose de velux"],
      "sameAs": []
    })} />

    {extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Google tag (gtag.js) — chargé uniquement après consentement (bandeau cookies RGPD).
         TODO GA4 : remplacer G-XXXXXXXXXX par le vrai ID de mesure
         (tant que l'ID est le placeholder, rien ne se charge). -->
    <script is:inline>
      var SITE_GA_ID = 'G-XXXXXXXXXX';
      window.siteLoadAnalytics = function () {
        if (window.siteGaLoaded || SITE_GA_ID === 'G-XXXXXXXXXX') return;
        window.siteGaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + SITE_GA_ID;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', SITE_GA_ID);
      };
      try {
        if (localStorage.getItem('site-cookies') === 'accepte') window.siteLoadAnalytics();
      } catch (e) {}
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingContact />
    <BandeauCookies />
  </body>
</html>
