---
// ─────────────────────────────────────────────────────────────────────────
// ACCUEIL — hub SEO Haute-Garonne (31). Contenu calqué sur la home en ligne.
// ─────────────────────────────────────────────────────────────────────────
import BaseLayout from '../layouts/BaseLayout.astro';
import FlecheRonde from '../components/FlecheRonde.astro';
import { SITE } from '../data/site.ts';
import { ZONES, HUBS_ZONES, LIENS_VILLES } from '../data/zones.ts';

const title = 'Couvreur en Haute-Garonne (31) — Charles Lopez, artisan couvreur';
const description =
  'Charles Lopez, artisan couvreur en Haute-Garonne : entretien et démoussage, réparation, rénovation et étanchéité de toiture. Particuliers et professionnels. Devis gratuit.';

// Échantillon de prestations (repris tel quel de la home en ligne).
const echantillon = [
  'Travaux de couverture', 'Démoussage de toiture', 'Nettoyage de toiture',
  'Remplacement de gouttière', 'Nettoyage de chéneaux', 'Rénovation de toiture',
  'Suppression de cheminée', 'Peinture sur toiture', 'Étanchéité de toiture',
  'Pose de toiture neuve', 'Pose de velux', 'Isolation sous toiture',
  'Pose de pare-vapeur', 'Recherche de fuite sur une toiture', 'Vérification de pied de cheminée',
  'Diagnostic de toiture', 'Traitement de charpente',
];

const zones = ZONES;

const galerie = [
  { img: '/images/photos/chantier-13.webp', alt: 'Chantier de couverture en Haute-Garonne' },
  { img: '/images/photos/chantier-14.webp', alt: 'Rénovation de toiture par Charles Lopez' },
  { img: '/images/photos/chantier-15.webp', alt: 'Travaux de toiture en Haute-Garonne' },
  { img: '/images/photos/chantier-16.webp', alt: 'Toiture rénovée par Charles Lopez' },
];
// Avis clients réels (Google & PagesJaunes) — note 5/5.
const avis = [
  { note: 5, source: 'google', nom: 'Toquard Betsy', date: 'Janvier 2023',
    texte: 'Monsieur Lopez a effectué le remplacement de la toiture de ma maison. Très satisfait, je recommande : personne sérieuse, très propre et à l\'écoute du client.' },
  { note: 5, source: 'pagesjaunes', nom: 'Thierry G. — Aussonne', date: 'Octobre 2024',
    texte: 'Monsieur Lopez répond au téléphone et fait ce qu\'il dit, très bien. C\'est tellement rare de nos jours. Je recommande.' },
  { note: 5, source: 'google', nom: 'Serge Etienne', date: 'Janvier 2025',
    texte: 'Artisan consciencieux et sérieux, bon travail. À recommander.' },
  { note: 5, source: 'pagesjaunes', nom: 'Jean-Paul', date: 'Décembre 2023',
    texte: 'Travail professionnel et efficace. Chantier quitté après nettoyage des lieux. Équipe réactive et sympathique, ce qui ne gâche rien. À recommander.' },
  { note: 5, source: 'google', nom: 'Marc Fournier', date: 'Décembre 2023',
    texte: 'Très satisfait de ses services, je recommande ce couvreur.' },
  { note: 5, source: 'pagesjaunes', nom: 'Alain M. — 31', date: 'Avril 2023',
    texte: 'Très bon travail pour la réfection de toute la toiture de ma maison et du garage, plus la peinture. Rien à redire, je recommande.' },
];

---

<BaseLayout title={title} description={description}>

  <!-- ── Hero (titre + photo + arguments) ──────────────────── -->
  <section class="hx">
    <div class="conteneur hx__grid">
      <div class="hx__head">
        <h1 class="hx__title">Artisan couvreur à <span class="hx__ville">Cornebarrieu&nbsp;(31)</span><br>pour tous vos travaux de toiture</h1>
        <p class="hx__marque">{SITE.nom}</p>
      </div>

      <div class="hx__right">
        <img
          class="hx__photo"
          src="/images/photos/placeholder-hero-1024.webp"
          srcset="/images/photos/placeholder-hero-640.webp 640w, /images/photos/placeholder-hero-1024.webp 1024w, /images/photos/placeholder-hero-1600.webp 1600w"
          sizes="(min-width: 960px) 46vw, calc(100vw - 2rem)"
          width="1600"
          height="1066"
          alt="Charles Lopez, artisan couvreur, sur une toiture en Haute-Garonne"
          fetchpriority="high"
        />
      </div>

      <div class="hx__body">
        <p class="hx__sub">
          Entretien, réparation, rénovation et étanchéité de toiture en Haute-Garonne — pour les
          particuliers comme pour les professionnels.
        </p>

        <ul class="reass__points hx__points">
          <li>
            <span class="reass__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Couvreur de père en fils
          </li>
          <li>
            <span class="reass__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            + de 15 ans d’expérience
          </li>
          <li>
            <span class="reass__check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 12.5l2.5 2.5 5-6"/></svg></span>
            Garantie décennale
          </li>
        </ul>

        <div class="reass__badges hx__badges">
          <img src="/images/badges/garantie-decennale.webp" alt="Garantie décennale et responsabilité civile professionnelle" height="56" width="163" loading="lazy" />
          <img src="/images/badges/chambre-des-metiers.webp" alt="Inscrit à la Chambre des Métiers de la Haute-Garonne" height="56" width="82" loading="lazy" />
        </div>

        <div class="hx__cta">
          <a href="/devis-gratuit/" class="btn btn--rouge hx__btn">
            <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15l2 2 4-4"/></svg>
            Devis gratuit 7j/7
          </a>
          <p class="hx__cta-sub">Réponse rapide, sans engagement</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Notre métier (texte + photo + adresse) ───────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <div class="duo">
        <img src="/images/photos/pose-velux.webp" alt="Pose de velux sur tuiles canal par Charles Lopez" loading="lazy" width="900" height="1200" />
        <div>
          <h2>Mon métier : artisan couvreur en Haute-Garonne&nbsp;(31)</h2>
          <p>
            Mon métier consiste à prendre soin de votre toiture. Pour cela, j’entretiens, je répare
            et je rénove les toitures en Haute-Garonne. Mon rôle est d’assurer le bon état et
            l’étanchéité de votre toit : il doit rester solide et étanche en permanence.
          </p>
          <p>
            Vous constatez un problème sur votre toiture ? Il faut réagir rapidement et faire
            intervenir un professionnel. Je me déplace au quotidien sur l’ensemble du département
            pour réaliser un diagnostic de l’état de votre toit et vous proposer la solution adaptée.
          </p>
          <p class="metier__adresse">
            Je suis basé au cœur de la Haute-Garonne — <strong>{SITE.rue}, {SITE.cp} {SITE.ville}</strong>.
            J’interviens sur l’ensemble du département.
          </p>
          <div class="hero3__actions">
            <a href={SITE.telHref} class="btn btn--rouge">
              <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2.2"/><line x1="11" y1="18.3" x2="13" y2="18.3"/></svg>
              {SITE.tel}
            </a>
            <a href="/devis-gratuit/" class="btn btn--bleu">Contactez-moi<FlecheRonde /></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Mes services (aperçu icônes) ─────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <div class="services-box">
        <h2 class="services-box__titre">Mes services de couvreur dans le 31</h2>
        <p class="services-box__intro">
          Professionnel des travaux de toiture, je vous propose une gamme de services permettant
          d’entretenir, de réparer et de rénover votre toit en Haute-Garonne.
        </p>
        <div class="services-grid">

          <a class="service-card" href="/renovation-de-toiture-en-haute-garonne-31/">
            <span class="service-card__icone"><img src="/images/icones/icone-remplacement.webp" width="76" height="76" alt="" loading="lazy" /></span>
            <h3 class="service-card__titre">Remplacement de toiture</h3>
            <p>Je suis un spécialiste du remplacement de toiture en Haute-Garonne. Je réalise les travaux permettant de remplacer votre toit. Avec une toiture neuve, votre maison ancienne est bien protégée.</p>
          </a>

          <a class="service-card" href="/reparation-de-toiture-en-haute-garonne-31/">
            <span class="service-card__icone"><img src="/images/icones/icone-reparation.webp" width="76" height="76" alt="" loading="lazy" /></span>
            <h3 class="service-card__titre">Réparation de toiture</h3>
            <p>J’interviens rapidement pour effectuer des réparations sur votre toiture en Haute-Garonne. Contactez-moi, il ne faut surtout pas que la situation s’aggrave.</p>
          </a>

          <a class="service-card" href="/nettoyage-de-toiture-en-haute-garonne-31/">
            <span class="service-card__icone"><img src="/images/icones/icone-nettoyage.webp" width="76" height="76" alt="" loading="lazy" /></span>
            <h3 class="service-card__titre">Nettoyage de toiture</h3>
            <p>Le nettoyage de toiture est absolument essentiel. Je nettoie les toitures, je retire les mousses et les lichens. Je valorise votre habitation avec une toiture propre.</p>
          </a>

          <a class="service-card" href="/recherche-de-fuite-de-toiture-en-haute-garonne-31/">
            <span class="service-card__icone"><img src="/images/icones/icone-fuite.webp" width="76" height="76" alt="" loading="lazy" /></span>
            <h3 class="service-card__titre">Recherche de fuites</h3>
            <p>Je recherche les fuites sur votre toit et j’effectue les réparations. Je suis un spécialiste de l’étanchéité de toiture.</p>
          </a>

        </div>
      </div>
    </div>
  </section>

  <!-- ── Des travaux dans toutes les villes (2 colonnes + carte) ── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2 class="villes-titre">Des travaux de couverture dans toutes les villes de Haute-Garonne</h2>
      <p class="villes-intro">
        Je me déplace quotidiennement sur l’ensemble du département en Haute-Garonne, pour la plus
        grande satisfaction de mes clients. Vous êtes à la recherche d’un couvreur spécialiste des
        travaux sur les toitures en tuile, en tuile canal ou tuile romane, ou les matériaux plus
        modernes tels que le bac-acier ? Je suis à votre service. Voici un échantillon de mes
        prestations.
      </p>

      <div class="prestations-carte">
        <ul class="prestations-liste">
          {echantillon.slice(0, 8).map((p) => <li>{p}</li>)}
        </ul>
        <img
          class="prestations-map"
          src="/images/photos/carte-haute-garonne.webp"
          alt="Carte de la Haute-Garonne (31) — zone d’intervention de Charles Lopez"
          width="480"
          height="480"
          loading="lazy"
        />
        <ul class="prestations-liste">
          {echantillon.slice(8).map((p) => <li>{p}</li>)}
        </ul>
      </div>

      <div class="villes-cta">
        <h2>Demandez la visite d’un couvreur dans votre ville</h2>
        <p>Mes devis et déplacements sont offerts dans toutes les villes de Haute-Garonne.</p>
        <a href="/devis-gratuit/" class="btn btn--rouge">Demander un devis gratuit<FlecheRonde /></a>
      </div>
    </div>
  </section>

  <!-- ── Galerie de réalisations ──────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <h2>Quelques réalisations</h2>
      <div class="galerie">
        {galerie.map((g) => (
          <img class="galerie__img" src={g.img} alt={g.alt} loading="lazy" width="700" height="470" />
        ))}
      </div>
    </div>
  </section>

  <!-- ── Avis clients ─────────────────────────────────────────── -->
  <section class="section section--gris">
    <div class="conteneur">
      <h2>Ils m’ont fait confiance</h2>
      <p class="avis-intro">
        <span class="avis-intro__stars"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg></span>
        <strong>5/5</strong> — mes clients recommandent mon travail sur Google et PagesJaunes.
      </p>

      <div class="avis-grille">
        {avis.map((a) => (
          <article class="avis-card">
            <div class="avis-card__stars" aria-label={`Note ${a.note} sur 5`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.9.6-5.2 4.53 1.55 6.75L12 17.77 5.85 20.7 7.4 13.95 2.2 9.42l6.9-.6L12 2z"/></svg>
            </div>
            <p class="avis-card__texte">« {a.texte} »</p>
            <div class="avis-card__pied">
              <div class="avis-card__auteur">
                <span class="avis-card__nom">{a.nom}</span>
                <span class="avis-card__date">{a.date}</span>
              </div>
              {a.source === 'google' ? (
                <span class="avis-badge avis-badge--google"><svg class="avis-g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.28-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg> Google</span>
              ) : (
                <span class="avis-badge avis-badge--pj">PagesJaunes</span>
              )}
            </div>
          </article>
        ))}
      </div>

      <div class="avis-cta">
        <a href={SITE.googleAvis} target="_blank" rel="noopener" class="btn btn--rouge">
          <svg class="avis-g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.28-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg> Laisser un avis Google
        </a>
      </div>
    </div>
  </section>

  <!-- ── Zone d'intervention ──────────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <h2>Zone d’intervention</h2>
      <p class="zones__intro">
        Basé à {SITE.ville} ({SITE.cp}), j’interviens sur l’ensemble de la {SITE.departement}
        ({SITE.departementNum}), et particulièrement dans le nord-ouest toulousain. Retrouvez
        ci-dessous les communes où j’interviens au quotidien.
      </p>
      <ul class="villes-chips">
        {zones[0].villes.map((v) => (
          <li>
            <a href={LIENS_VILLES[v]} class="ville-chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {v}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── CTA final ────────────────────────────────────────────── -->
  <section class="section">
    <div class="conteneur">
      <div class="cta-reno cta-reno--inverse">
        <div class="cta-reno__panneau">
          <h2>Un artisan au service de votre toiture</h2>
          <p>
            Toiture à entretenir, fuite à traiter ou projet de rénovation ? J’interviens à
            {SITE.ville} et dans toute la {SITE.departement} ({SITE.departementNum}), rapidement et
            même en urgence. Déplacement, conseil et devis détaillé gratuits.
          </p>
          <div class="cta-reno__actions">
            <a href={SITE.telHref} class="btn btn--rouge">
              <svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="2.2"/><line x1="11" y1="18.3" x2="13" y2="18.3"/></svg>
              {SITE.tel}
            </a>
            <a href="/devis-gratuit/" class="btn btn--blanc">Devis gratuit<FlecheRonde /></a>
          </div>
        </div>
        <img class="cta-reno__img" src="/images/photos/placeholder-photo-1.webp" alt="Charles Lopez, artisan couvreur en Haute-Garonne" loading="lazy" width="900" height="700" />
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  /* Hero éditorial : image contenue avec cartouche titre en surplomb bas-gauche */
  .hero3 { padding-block: clamp(1.8rem, 4vw, 3rem); }
  .hero3__bloc { max-width: 940px; margin-inline: auto; }
  .hero3__img {
    display: block;
    width: 100%;
    height: clamp(240px, 40vw, 420px);
    object-fit: cover;
    border-radius: var(--rayon);
  }
  .hero3__carte {
    position: relative;
    z-index: 2;
    background: var(--blanc);
    border-radius: var(--rayon);
    box-shadow: var(--ombre-forte);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    margin: -3.5rem 1.4rem 0;
    max-width: 640px;
  }
  .hero3__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--rouge-fonce);
    margin-bottom: 0.5rem;
  }
  .hero3__carte h1 { margin: 0; font-size: clamp(1.3rem, 3.2vw, 1.7rem); line-height: 1.25; }
  .hero3__marque {
    color: var(--rouge);
    font-weight: 800;
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.1;
    margin: 0.4rem 0 0;
  }
  .hero3__accroche { color: var(--bleu); margin: 0.9rem 0 1.3rem; }
  .hero3__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  @media (max-width: 700px) {
    .hero3__carte { margin: -2rem 0.6rem 0; padding: 1.2rem 1.1rem 1.4rem; }
    .hero3__eyebrow, .hero3__carte h1 { text-align: left; }
    .hero3__carte h1 { font-size: 1.55rem; line-height: 1.2; }
    .hero3__marque { font-size: 1.35rem; }
    .hero3__actions { justify-content: center; }
    .hero3__actions .btn { flex: 1 1 auto; min-width: 0; justify-content: center; }
  }
  @media (max-width: 380px) {
    .hero3__carte h1 { font-size: 1.4rem; }
  }

