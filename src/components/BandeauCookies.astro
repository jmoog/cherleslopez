---
// Bandeau de consentement RGPD : Google Analytics ne se charge qu'après « Accepter ».
// Le choix est mémorisé dans localStorage (clé « site-cookies » : accepte / refuse).
---
<div id="bandeau-cookies" class="bandeau" hidden role="dialog" aria-live="polite" aria-label="Consentement aux cookies">
  <div class="bandeau__pastille" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2a10 10 0 1 0 10 10 3.2 3.2 0 0 1-3.5-3.5A3.2 3.2 0 0 1 15 5 3.2 3.2 0 0 1 12 2Z"/>
      <circle cx="9" cy="10" r="0.6" fill="currentColor"/>
      <circle cx="13.5" cy="14" r="0.6" fill="currentColor"/>
      <circle cx="8.5" cy="15" r="0.6" fill="currentColor"/>
      <circle cx="15" cy="9.5" r="0.6" fill="currentColor"/>
    </svg>
  </div>
  <div class="bandeau__corps">
    <p class="bandeau__titre">Votre confidentialité</p>
    <p class="bandeau__texte">
      Nous utilisons des cookies de mesure d'audience (Google&nbsp;Analytics) pour améliorer votre
      expérience. <a href="/mentions-legales/">En savoir plus</a>
    </p>
    <div class="bandeau__actions">
      <button type="button" id="cookies-refuser" class="bandeau__btn bandeau__btn--refuser">Refuser</button>
      <button type="button" id="cookies-accepter" class="bandeau__btn bandeau__btn--accepter">Accepter</button>
    </div>
  </div>
</div>

<style>
  /* Indispensable : display:flex ci-dessous écraserait l'attribut hidden sans cette règle */
  .bandeau[hidden] { display: none; }

  .bandeau {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 1000;
    width: min(26rem, calc(100vw - 2rem));
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.15rem 1.25rem 1.25rem;
    background: var(--blanc, #fff);
    color: var(--gris-700, #3f3a34);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 1rem;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18);
    animation: bandeau-apparait 0.35s ease both;
  }
  @keyframes bandeau-apparait {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .bandeau__pastille {
    flex-shrink: 0;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--rouge, #c8102e);
    color: #fff;
    box-shadow: 0 4px 12px rgba(232, 90, 39, 0.35);
  }
  .bandeau__pastille svg { width: 1.5rem; height: 1.5rem; }
  .bandeau__corps { flex: 1; min-width: 0; }
  .bandeau__titre {
    margin: 0 0 0.25rem;
    font-weight: 800;
    font-size: 1rem;
    color: var(--bleu, #0a4f96);
  }
  .bandeau__texte {
    margin: 0 0 0.9rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--gris-700, #4a453f);
  }
  .bandeau__texte a {
    color: var(--bleu-accent, #0a4f96); /* même bleu que les liens du site */
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .bandeau__actions {
    display: flex;
    gap: 0.6rem;
  }
  .bandeau__btn {
    font: inherit;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.6rem 1.15rem;
    border-radius: 0.6rem;
    cursor: pointer;
    border: 1.5px solid transparent;
    transition: transform 0.12s ease, background 0.15s ease, box-shadow 0.15s ease;
  }
  .bandeau__btn:active { transform: translateY(1px); }
  .bandeau__btn--accepter {
    flex: 1;
    background: var(--rouge-fonce, #c4481a); /* texte blanc dessus : AA 4.9:1 */
    color: #fff;
    box-shadow: 0 4px 12px rgba(196, 72, 26, 0.3);
  }
  .bandeau__btn--accepter:hover { background: var(--rouge-sombre, #a83d15); }
  .bandeau__btn--refuser {
    background: var(--blanc, #fff);
    color: var(--gris-700, #4a453f);
    border-color: rgba(0, 0, 0, 0.18);
  }
  .bandeau__btn--refuser:hover { background: var(--gris-100, #f4f2ef); }

  @media (max-width: 480px) {
    .bandeau { left: 0.75rem; right: 0.75rem; bottom: 0.75rem; width: auto; }
  }
</style>

<script is:inline>
  (function () {
    var bandeau = document.getElementById('bandeau-cookies');
    if (!bandeau) return;
    var choix = null;
    try { choix = localStorage.getItem('site-cookies'); } catch (e) {}
    if (choix === 'accepte' || choix === 'refuse') return; // choix déjà fait, bandeau masqué

    bandeau.hidden = false;

    function repondre(valeur) {
      try { localStorage.setItem('site-cookies', valeur); } catch (e) {}
      bandeau.hidden = true;
      if (valeur === 'accepte' && typeof window.siteLoadAnalytics === 'function') {
        window.siteLoadAnalytics();
      }
    }
    document.getElementById('cookies-accepter').addEventListener('click', function () { repondre('accepte'); });
    document.getElementById('cookies-refuser').addEventListener('click', function () { repondre('refuse'); });
  })();
</script>
